<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VaultSync.Desktop.ViewModels" xmlns:core="using:VaultSync.Core"
        x:Class="VaultSync.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        Background="#0B1120" Title="VaultSync — Intelligent Backup &amp; Recovery">
  <Window.Styles>
    <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#1E3A5F"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="18,11"/><Setter Property="CornerRadius" Value="8"/></Style>
    <Style Selector="Button.secondary"><Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Padding" Value="16,10"/><Setter Property="CornerRadius" Value="8"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#152238"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F8FAFC"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F8FAFC"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#94A3B8"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#0F172A"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="Background" Value="#0F172A"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="CornerRadius" Value="8"/></Style>
  </Window.Styles>
  <Grid ColumnDefinitions="230,*">
    <Border Background="#0F172A" Padding="18">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="34" Height="34" CornerRadius="10" Background="#3B82F6"><TextBlock Text="V" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="VAULTSYNC" FontWeight="Bold" FontSize="17"/><TextBlock Text="ZERO-TRUST BACKUP" FontSize="9" Foreground="#2DD4BF"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,34,0,0">
          <Button Classes="nav" Content="⌂  Dashboard" Command="{Binding NavigateCommand}" CommandParameter="0"/>
          <Button Classes="nav" Content="▤  My Files" Command="{Binding NavigateCommand}" CommandParameter="1"/>
          <Button Classes="nav" Content="⇅  Backup Manager" Command="{Binding NavigateCommand}" CommandParameter="2"/>
          <Button Classes="nav" Content="↶  Recovery Center" Command="{Binding NavigateCommand}" CommandParameter="3"/>
          <Button Classes="nav" Content="◇  Security Center" Command="{Binding NavigateCommand}" CommandParameter="4"/>
          <Button Classes="nav" Content="▥  Analytics" Command="{Binding NavigateCommand}" CommandParameter="5"/>
          <Button Classes="nav" Content="⚙  Settings" Command="{Binding NavigateCommand}" CommandParameter="6"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#152238" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="VAULT STATUS" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding IsVaultUnlocked, StringFormat='Unlocked: {0}'}" Foreground="#2DD4BF" Margin="0,5,0,0"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <TabControl SelectedIndex="{Binding SelectedSection}" Background="Transparent" Padding="24">
        <TabControl.Styles><Style Selector="TabStrip"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="TabItem"><Setter Property="Padding" Value="0"/></Style></TabControl.Styles>
        <TabItem Header="Dashboard"><ScrollViewer><StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="h1" Text="Backup command center"/><TextBlock Classes="muted" Text="Encrypted snapshots, recovery health, and storage efficiency."/></StackPanel><Button Grid.Column="1" Classes="primary" Content="Start backup" Command="{Binding StartBackupCommand}"/></Grid>
          <UniformGrid Columns="4">
            <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="PROTECTED FILES"/><TextBlock Text="{Binding ProtectedFilesText}" FontSize="29" FontWeight="Bold"/><TextBlock Text="Latest snapshot" Foreground="#2DD4BF"/></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="SNAPSHOTS"/><TextBlock Text="{Binding SnapshotCountText}" FontSize="29" FontWeight="Bold"/><TextBlock Text="Version history" Foreground="#60A5FA"/></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="LOGICAL DATA"/><TextBlock Text="{Binding LogicalSizeText}" FontSize="29" FontWeight="Bold"/><TextBlock Text="Protected content" Foreground="#60A5FA"/></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="DEDUP SAVED"/><TextBlock Text="{Binding SavedSizeText}" FontSize="29" FontWeight="Bold"/><TextBlock Text="Content-addressed" Foreground="#2DD4BF"/></StackPanel></Border>
          </UniformGrid>
          <Grid ColumnDefinitions="2*,*">
            <Border Classes="card"><StackPanel><TextBlock Classes="h2" Text="Backup health"/><TextBlock Classes="muted" Text="Real results from the vault index" Margin="0,4,0,16"/><Grid ColumnDefinitions="*,*"><StackPanel><TextBlock Text="SUCCESS RATE" Classes="muted"/><TextBlock Text="{Binding SuccessRateText}" FontSize="38" FontWeight="Bold" Foreground="#2DD4BF"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LAST SUCCESS" Classes="muted"/><TextBlock Text="{Binding LastBackupText}" FontSize="18" Margin="0,9,0,0"/></StackPanel></Grid><ProgressBar Value="{Binding ProgressPercent}" Height="8" Margin="0,22,0,7" Foreground="#3B82F6"/><TextBlock Text="{Binding ProgressLabel}" Classes="muted"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="card"><StackPanel><TextBlock Classes="h2" Text="Recent activity"/><ItemsControl ItemsSource="{Binding Activity}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5" Foreground="#CBD5E1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Activity appears after real operations." Classes="muted" Margin="0,10,0,0"/></StackPanel></Border>
          </Grid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Files"><Grid RowDefinitions="Auto,*"><StackPanel><TextBlock Classes="h1" Text="My files"/><TextBlock Classes="muted" Text="Browse real files referenced by the selected snapshot."/></StackPanel><Grid Grid.Row="1" ColumnDefinitions="320,*" Margin="0,18,0,0"><Border Classes="card"><ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"><ListBox.ItemTemplate><DataTemplate x:DataType="core:SnapshotSummary"><StackPanel Margin="4,7"><TextBlock Text="{Binding CreatedUtc}"/><TextBlock Text="{Binding State}" Foreground="#2DD4BF"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="1" Classes="card"><DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size}" Width="130"/><DataGridTextColumn Header="Modified" Binding="{Binding LastWriteUtc}" Width="190"/></DataGrid.Columns></DataGrid></Border></Grid></Grid></TabItem>
        <TabItem Header="Backup"><ScrollViewer><StackPanel><TextBlock Classes="h1" Text="Backup manager"/><TextBlock Classes="muted" Text="Protect a real folder with incremental encrypted snapshots."/>
          <Border Classes="card" Margin="0,20,0,14"><StackPanel Spacing="9"><TextBlock Classes="h2" Text="Protected folder"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Text="{Binding SourcePath}" PlaceholderText="Folder to protect"/><Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="SelectSource_Click"/></Grid><TextBlock Classes="h2" Text="Vault destination" Margin="0,10,0,0"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Text="{Binding VaultPath}" PlaceholderText="Separate backup destination"/><Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="SelectVault_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0"><Button Classes="primary" Content="Back up now" Command="{Binding StartBackupCommand}"/><Button Classes="secondary" Content="Cancel" Command="{Binding CancelOperationCommand}"/><Button Classes="secondary" Content="Enable / pause automatic backup" Command="{Binding ToggleAutomaticBackupCommand}"/></StackPanel></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="h2" Text="Live operation"/><ProgressBar Value="{Binding ProgressPercent}" Height="10" Margin="0,14,0,8"/><TextBlock Text="{Binding ProgressLabel}" Classes="muted"/><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Recovery"><Grid RowDefinitions="Auto,*"><StackPanel><TextBlock Classes="h1" Text="Recovery center"/><TextBlock Classes="muted" Text="Restore an authenticated snapshot without touching source files."/></StackPanel><Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,20,0,0"><Border Classes="card"><StackPanel><TextBlock Classes="h2" Text="1. Select snapshot"/><ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" Margin="0,12,0,0" Height="420"><ListBox.ItemTemplate><DataTemplate x:DataType="core:SnapshotSummary"><Grid ColumnDefinitions="*,Auto" Margin="5,8"><StackPanel><TextBlock Text="{Binding CreatedUtc}"/><TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" Classes="muted"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#2DD4BF"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><Border Grid.Column="1" Classes="card"><StackPanel Spacing="10"><TextBlock Classes="h2" Text="2. Choose destination"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding RecoveryPath}" PlaceholderText="Empty or existing recovery folder"/><Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="SelectRecovery_Click"/></Grid><CheckBox Content="Overwrite existing files (explicit confirmation)" IsChecked="{Binding OverwriteExisting}"/><Button Classes="primary" Content="Restore and verify" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,15,0,0"/><TextBlock Classes="muted" Text="Files are decrypted to temporary files, authenticated chunk-by-chunk, SHA-256 verified, then atomically finalized." TextWrapping="Wrap"/></StackPanel></Border></Grid></Grid></TabItem>
        <TabItem Header="Security"><StackPanel><TextBlock Classes="h1" Text="Security center"/><TextBlock Classes="muted" Text="Initialize, unlock, and validate your encrypted vault."/><Grid ColumnDefinitions="*,*" Margin="0,20,0,0"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="h2" Text="Vault access"/><TextBox Text="{Binding VaultName}" PlaceholderText="Vault name"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding VaultPath}" PlaceholderText="Vault location"/><Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="SelectVault_Click"/></Grid><TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Password (10+ characters)"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="primary" Content="Initialize new vault" Command="{Binding InitializeVaultCommand}"/><Button Classes="secondary" Content="Unlock existing" Command="{Binding UnlockVaultCommand}"/></StackPanel></StackPanel></Border><Border Grid.Column="1" Classes="card"><StackPanel Spacing="10"><TextBlock Classes="h2" Text="Cryptographic posture"/><TextBlock Text="AES-256-GCM" FontSize="23" FontWeight="Bold" Foreground="#2DD4BF"/><TextBlock Classes="muted" Text="Authenticated 1 MiB chunks • unique 96-bit nonce per chunk • SHA-256 content addressing • PBKDF2-HMAC-SHA256 key wrapping" TextWrapping="Wrap"/><Button Classes="secondary" Content="Rebuild index from encrypted manifests" Command="{Binding RebuildIndexCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border></Grid></StackPanel></TabItem>
        <TabItem Header="Analytics"><StackPanel><TextBlock Classes="h1" Text="Storage analytics"/><TextBlock Classes="muted" Text="Calculated from SQLite metadata and the actual vault on disk."/><UniformGrid Columns="3" Margin="0,20,0,0"><Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="PHYSICAL VAULT"/><TextBlock Text="{Binding PhysicalSizeText}" FontSize="30" FontWeight="Bold"/></StackPanel></Border><Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="LOGICAL SIZE"/><TextBlock Text="{Binding LogicalSizeText}" FontSize="30" FontWeight="Bold"/></StackPanel></Border><Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="DEDUPLICATION SAVINGS"/><TextBlock Text="{Binding SavedSizeText}" FontSize="30" FontWeight="Bold" Foreground="#2DD4BF"/></StackPanel></Border></UniformGrid><Border Classes="card"><StackPanel><TextBlock Classes="h2" Text="Duplicate groups in selected snapshot"/><ItemsControl ItemsSource="{Binding DuplicateGroups}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:DuplicateGroup"><Grid ColumnDefinitions="*,Auto" Margin="0,6"><TextBlock Text="{Binding ContentHash}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding PotentialSavings, StringFormat='{}{0} bytes potentially saved'}" Foreground="#2DD4BF"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="VaultSync never deletes duplicate source files." Classes="muted" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></TabItem>
        <TabItem Header="Settings"><StackPanel><TextBlock Classes="h1" Text="Settings"/><TextBlock Classes="muted" Text="Operational controls for this application session."/><Border Classes="card" Margin="0,20,0,0"><Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="14"><TextBlock Text="Reconciliation interval"/><NumericUpDown Grid.Column="1" Value="{Binding IntervalMinutes}" Minimum="1" Maximum="1440"/><TextBlock Grid.Row="1" Text="File exclusions"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExclusionsText}" AcceptsReturn="True" Height="130" PlaceholderText="One path or *.extension per line"/></Grid></Border><TextBlock Classes="muted" Text="Automatic backups run only while VaultSync is open. FileSystemWatcher events are debounced and backed by full reconciliation scans." TextWrapping="Wrap"/></StackPanel></TabItem>
      </TabControl>
      <Border Grid.Row="1" Background="#101A2C" Padding="16,10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding IsBusy, StringFormat='Working: {0}'}" Foreground="#94A3B8"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
